datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. TENANT & ORGANIZATION HIERARCHY
// ==========================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  logoUrl     String?
  address     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  schools             School[]
  users               User[]
  students            Student[]
  guardians           Guardian[]
  teachers            Teacher[]
  staff               Staff[]
  enrollments         StudentEnrollment[]
  attendanceSessions  AttendanceSession[]
  attendanceRecords   AttendanceRecord[]
  leaveApplications   LeaveApplication[]
  invoices            Invoice[]
  payments            Payment[]
  refunds             Refund[]
  exams               Exam[]
  studentMarks        StudentMark[]
  reportCards         ReportCard[]
  periodSlots         PeriodSlot[]
  timetables          Timetable[]
  timetableAllocations TimetableAllocation[]
  homeworks           Homework[]
  homeworkSubmissions HomeworkSubmission[]
  salaryStructures    SalaryStructure[]
  payslips            Payslip[]
  notices             Notice[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  fileAssets          FileAsset[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  stockTransactions   StockTransaction[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  certificateTemplates CertificateTemplate[]
  issuedCertificates   IssuedCertificate[]

  @@map("organizations")
}

model School {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String   @unique
  logoUrl        String?
  address        String?
  phone          String?
  email          String?
  website        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campuses            Campus[]
  academicYears       AcademicYear[]
  systemSettings      SystemSetting[]
  users               User[]
  roles               Role[]
  classes             Class[]
  sections            Section[]
  subjects            Subject[]
  students            Student[]
  guardians           Guardian[]
  teachers            Teacher[]
  staff               Staff[]
  enrollments         StudentEnrollment[]
  attendanceSessions  AttendanceSession[]
  attendanceRecords   AttendanceRecord[]
  leaveApplications   LeaveApplication[]
  feeCategories       FeeCategory[]
  feeStructures       FeeStructure[]
  feeDiscounts        FeeDiscount[]
  invoices            Invoice[]
  payments            Payment[]
  refunds             Refund[]
  gradingScales       GradingScale[]
  exams               Exam[]
  studentMarks        StudentMark[]
  reportCards         ReportCard[]
  periodSlots         PeriodSlot[]
  timetables          Timetable[]
  timetableAllocations TimetableAllocation[]
  homeworks           Homework[]
  homeworkSubmissions HomeworkSubmission[]
  salaryStructures    SalaryStructure[]
  payslips            Payslip[]
  notices             Notice[]
  notifications       Notification[]
  libraryBooks        LibraryBook[]
  bookLoans           BookLoan[]
  transportRoutes     TransportRoute[]
  vehicles            Vehicle[]
  studentTransports   StudentTransport[]
  auditLogs           AuditLog[]
  fileAssets          FileAsset[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  stockTransactions   StockTransaction[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  certificateTemplates CertificateTemplate[]
  issuedCertificates   IssuedCertificate[]

  @@index([organizationId])
  @@map("schools")
}

model Campus {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  code      String
  address   String?
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("campuses")
}

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String   // e.g. "2026-2027"
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments        StudentEnrollment[]
  attendanceSessions AttendanceSession[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  exams              Exam[]
  reportCards        ReportCard[]
  timetables         Timetable[]

  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model SystemSetting {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  key         String
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@map("system_settings")
}

// ==========================================
// 2. IDENTITY & RBAC
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                 String     @id @default(uuid())
  organizationId     String     @map("organization_id")
  schoolId           String     @map("school_id")
  email              String     @unique
  passwordHash       String     @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  phone              String?
  avatarUrl          String?    @map("avatar_url")
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school                 School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userRoles              UserRole[]
  sessions               UserSession[]
  passwordResets         PasswordReset[]
  studentProfile         Student?
  guardianProfile        Guardian?
  teacherProfile         Teacher?
  staffProfile           Staff?
  attendanceTaken        AttendanceSession[]
  leaveApplications      LeaveApplication[]  @relation("applicant")
  leaveReviews           LeaveApplication[]  @relation("reviewer")
  paymentsCollected      Payment[]           @relation("collector")
  refundsProcessed       Refund[]            @relation("processor")
  marksEntered           StudentMark[]
  noticesCreated         Notice[]
  notificationsReceived  Notification[]
  bookLoans              BookLoan[]
  salaryStructures       SalaryStructure[]
  payslips               Payslip[]
  auditLogs              AuditLog[]
  fileAssets             FileAsset[]

  @@index([schoolId, email])
  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  schoolId       String?  @map("school_id")
  name           String   // e.g. SUPER_ADMIN, TEACHER
  isSystem       Boolean  @default(false) @map("is_system")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school          School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([schoolId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "students.create"
  module      String   // e.g. "STUDENT"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  sessionToken String    @unique @map("session_token")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ==========================================
// 3. ACADEMIC STRUCTURE
// ==========================================

model Class {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  name         String   // e.g. "Grade 10"
  code         String
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections      Section[]
  classSubjects ClassSubject[]
  enrollments   StudentEnrollment[]
  feeStructures FeeStructure[]
  examSchedules ExamSchedule[]
  reportCards   ReportCard[]
  timetables    Timetable[]
  homeworks     Homework[]

  @@unique([schoolId, code])
  @@map("classes")
}

model Section {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  classId   String   @map("class_id")
  name      String   // e.g. "Section A"
  capacity  Int      @default(40)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments        StudentEnrollment[]
  attendanceSessions AttendanceSession[]
  examSchedules      ExamSchedule[]
  timetables         Timetable[]
  homeworks          Homework[]

  @@unique([classId, name])
  @@index([schoolId, classId])
  @@map("sections")
}

enum SubjectType {
  CORE
  ELECTIVE
  LAB
}

model Subject {
  id        String      @id @default(uuid())
  schoolId  String      @map("school_id")
  name      String      // e.g. "Mathematics"
  code      String
  type      SubjectType @default(CORE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects        ClassSubject[]
  attendanceSessions   AttendanceSession[]
  examSchedules        ExamSchedule[]
  timetableAllocations TimetableAllocation[]
  homeworks            Homework[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model ClassSubject {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  classId   String   @map("class_id")
  subjectId String   @map("subject_id")
  teacherId String?  @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

enum SlotType {
  ACADEMIC
  BREAK
  LUNCH
  ASSEMBLY
}

model PeriodSlot {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  name           String
  startTime      String   @map("start_time")
  endTime        String   @map("end_time")
  slotType       SlotType @default(ACADEMIC) @map("slot_type")
  orderIndex     Int      @default(1) @map("order_index")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allocations  TimetableAllocation[]

  @@unique([schoolId, orderIndex])
  @@map("period_slots")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Timetable {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  academicYearId String   @map("academic_year_id")
  classId        String   @map("class_id")
  sectionId      String   @map("section_id")
  name           String
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  isDefault      Boolean  @default(true) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section               @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  allocations  TimetableAllocation[]

  @@index([schoolId, classId, sectionId])
  @@map("timetables")
}

model TimetableAllocation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  schoolId       String    @map("school_id")
  timetableId    String    @map("timetable_id")
  dayOfWeek      DayOfWeek @map("day_of_week")
  periodSlotId   String    @map("period_slot_id")
  subjectId      String    @map("subject_id")
  teacherId      String?   @map("teacher_id")
  roomNumber     String?   @map("room_number")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetable    Timetable    @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  periodSlot   PeriodSlot   @relation(fields: [periodSlotId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([timetableId, dayOfWeek, periodSlotId])
  @@index([schoolId, teacherId, dayOfWeek, periodSlotId])
  @@index([schoolId, roomNumber, dayOfWeek, periodSlotId])
  @@map("timetable_allocations")
}

// ==========================================
// 3.1 HOMEWORK & ASSIGNMENTS
// ==========================================

model Homework {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  classId        String   @map("class_id")
  sectionId      String   @map("section_id")
  subjectId      String   @map("subject_id")
  teacherId      String   @map("teacher_id")
  title          String
  description    String   @db.Text
  assignedDate   DateTime @default(now()) @map("assigned_date")
  dueDate        DateTime @map("due_date")
  maxMarks       Decimal? @db.Decimal(5, 2) @map("max_marks")
  attachmentUrl  String?  @map("attachment_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class        Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions  HomeworkSubmission[]

  @@index([schoolId, classId, sectionId, dueDate])
  @@map("homeworks")
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  EVALUATED
  LATE
}

model HomeworkSubmission {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  schoolId          String           @map("school_id")
  homeworkId        String           @map("homework_id")
  studentId         String           @map("student_id")
  submissionDate    DateTime         @default(now()) @map("submission_date")
  content           String?          @db.Text
  attachmentUrl     String?          @map("attachment_url")
  status            SubmissionStatus @default(SUBMITTED)
  marksObtained     Decimal?         @db.Decimal(5, 2) @map("marks_obtained")
  remarks           String?
  evaluatedAt       DateTime?        @map("evaluated_at")
  evaluatedByUserId String?          @map("evaluated_by_user_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homework     Homework     @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([schoolId, homeworkId, status])
  @@map("homework_submissions")
}

// ==========================================
// 3.2 HR & PAYROLL SYSTEM
// ==========================================

model SalaryStructure {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  userId         String   @map("user_id")
  basicPay       Decimal  @db.Decimal(12, 2) @map("basic_pay")
  hra            Decimal  @default(0) @db.Decimal(12, 2)
  allowances     Decimal  @default(0) @db.Decimal(12, 2)
  deductions     Decimal  @default(0) @db.Decimal(12, 2)
  netSalary      Decimal  @db.Decimal(12, 2) @map("net_salary")
  effectiveDate  DateTime @default(now()) @map("effective_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId, userId])
  @@map("salary_structures")
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

model Payslip {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  schoolId          String        @map("school_id")
  userId            String        @map("user_id")
  month             Int
  year              Int
  basicPay          Decimal       @db.Decimal(12, 2) @map("basic_pay")
  hra               Decimal       @default(0) @db.Decimal(12, 2)
  allowances        Decimal       @default(0) @db.Decimal(12, 2)
  deductions        Decimal       @default(0) @db.Decimal(12, 2)
  grossSalary       Decimal       @db.Decimal(12, 2) @map("gross_salary")
  netSalary         Decimal       @db.Decimal(12, 2) @map("net_salary")
  status            PayrollStatus @default(PROCESSED)
  paymentDate       DateTime?     @map("payment_date")
  paymentMethod     String?       @map("payment_method")
  remarks           String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId, month, year])
  @@index([schoolId, month, year, status])
  @@map("payslips")
}

// ==========================================
// 4. PEOPLE & PROFILES
// ==========================================

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  ALUMNI
  SUSPENDED
}

model Student {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  schoolId         String        @map("school_id")
  userId           String        @unique @map("user_id")
  admissionNumber  String        @unique @map("admission_number")
  rollNumber       String?       @map("roll_number")
  dob              DateTime
  gender           String
  bloodGroup       String?       @map("blood_group")
  category         String?
  address          String?
  emergencyContact String?       @map("emergency_contact")
  status           StudentStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentGuardians  StudentGuardian[]
  enrollments       StudentEnrollment[]
  attendanceRecords AttendanceRecord[]
  invoices          Invoice[]
  payments          Payment[]
  studentMarks      StudentMark[]
  reportCards       ReportCard[]
  studentTransports StudentTransport[]
  homeworkSubmissions HomeworkSubmission[]
  issuedCertificates  IssuedCertificate[]

  @@index([schoolId, status])
  @@map("students")
}

model Guardian {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  userId         String?  @unique @map("user_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  relation       String   // e.g. FATHER, MOTHER, GUARDIAN
  occupation     String?
  phone          String
  email          String?
  income         Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentGuardians StudentGuardian[]

  @@index([schoolId, phone])
  @@map("guardians")
}

model StudentGuardian {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  guardianId String   @map("guardian_id")
  isPrimary  Boolean  @default(true) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

model Teacher {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  userId         String   @unique @map("user_id")
  employeeCode   String   @unique @map("employee_code")
  qualification  String?
  specialization String?
  joiningDate    DateTime @map("joining_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSubjects        ClassSubject[]
  timetableAllocations TimetableAllocation[]
  homeworks            Homework[]

  @@index([schoolId, employeeCode])
  @@map("teachers")
}

model Staff {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  userId         String   @unique @map("user_id")
  employeeCode   String   @unique @map("employee_code")
  department     String
  designation    String
  joiningDate    DateTime @map("joining_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, department])
  @@map("staff")
}

model StudentEnrollment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  academicYearId String   @map("academic_year_id")
  studentId      String   @map("student_id")
  classId        String   @map("class_id")
  sectionId      String   @map("section_id")
  rollNumber     String?  @map("roll_number")
  status         String   @default("ENROLLED")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, studentId])
  @@index([schoolId, classId, sectionId])
  @@map("student_enrollments")
}

// ==========================================
// 5. ATTENDANCE SYSTEM
// ==========================================

enum AttendanceType {
  DAILY
  SUBJECT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model AttendanceSession {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  schoolId       String         @map("school_id")
  academicYearId String         @map("academic_year_id")
  classId        String         @map("class_id")
  sectionId      String         @map("section_id")
  subjectId      String?        @map("subject_id")
  date           DateTime
  takenByUserId  String         @map("taken_by_user_id")
  type           AttendanceType @default(DAILY)
  createdAt      DateTime       @default(now()) @map("created_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subject           Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  section           Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  takenByUser       User               @relation(fields: [takenByUserId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@unique([schoolId, sectionId, subjectId, date])
  @@index([schoolId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  schoolId       String           @map("school_id")
  sessionId      String           @map("session_id")
  studentId      String           @map("student_id")
  date           DateTime
  status         AttendanceStatus
  remarks        String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([schoolId, studentId, date])
  @@map("attendance_records")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveApplication {
  id               String      @id @default(uuid())
  organizationId   String      @map("organization_id")
  schoolId         String      @map("school_id")
  applicantUserId  String      @map("applicant_user_id")
  startDate        DateTime    @map("start_date")
  endDate          DateTime    @map("end_date")
  reason           String      @db.Text
  status           LeaveStatus @default(PENDING)
  reviewedByUserId String?     @map("reviewed_by_user_id")
  reviewedAt       DateTime?   @map("reviewed_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicant    User         @relation("applicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("reviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@map("leave_applications")
}

// ==========================================
// 6. FINANCE ENGINE
// ==========================================

model FeeCategory {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String   // e.g. Tuition Fee, Bus Fee
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeComponents FeeComponent[]

  @@unique([schoolId, name])
  @@map("fee_categories")
}

model FeeStructure {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  academicYearId String   @map("academic_year_id")
  classId        String   @map("class_id")
  name           String   // e.g. "Grade 10 Annual Fee Structure"
  dueDate        DateTime @map("due_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  feeComponents FeeComponent[]

  @@index([schoolId, classId, academicYearId])
  @@map("fee_structures")
}

model FeeComponent {
  id             String   @id @default(uuid())
  feeStructureId String   @map("fee_structure_id")
  feeCategoryId  String   @map("fee_category_id")
  name           String
  amount         Decimal  @db.Decimal(12, 2)
  isOptional     Boolean  @default(false) @map("is_optional")
  createdAt      DateTime @default(now()) @map("created_at")

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeCategory  FeeCategory  @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@map("fee_components")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model FeeDiscount {
  id        String       @id @default(uuid())
  schoolId  String       @map("school_id")
  name      String       // e.g. Sibling Concession
  type      DiscountType @default(PERCENTAGE)
  value     Decimal      @db.Decimal(12, 2)
  createdAt DateTime     @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("fee_discounts")
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  schoolId       String        @map("school_id")
  academicYearId String        @map("academic_year_id")
  studentId      String        @map("student_id")
  invoiceNumber  String        @unique @map("invoice_number")
  dueDate        DateTime      @map("due_date")
  totalAmount    Decimal       @db.Decimal(12, 2) @map("total_amount")
  discountAmount Decimal       @default(0) @db.Decimal(12, 2) @map("discount_amount")
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2) @map("paid_amount")
  balanceAmount  Decimal       @db.Decimal(12, 2) @map("balance_amount")
  status         InvoiceStatus @default(UNPAID)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]
  payments     Payment[]

  @@index([schoolId, studentId, status])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String   @map("invoice_id")
  feeComponentId String?  @map("fee_component_id")
  description    String
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeComponent FeeComponent? @relation(fields: [feeComponentId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}

enum PaymentMode {
  CASH
  CARD
  UPI
  NETBANKING
  ONLINE
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  schoolId          String        @map("school_id")
  invoiceId         String        @map("invoice_id")
  studentId         String        @map("student_id")
  receiptNumber     String        @unique @map("receipt_number")
  amount            Decimal       @db.Decimal(12, 2)
  paymentMode       PaymentMode   @default(CASH) @map("payment_mode")
  transactionId     String?       @map("transaction_id")
  status            PaymentStatus @default(SUCCESS)
  idempotencyKey    String?       @unique @map("idempotency_key")
  collectedByUserId String        @map("collected_by_user_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  collector    User         @relation("collector", fields: [collectedByUserId], references: [id], onDelete: Cascade)
  refunds      Refund[]

  @@index([schoolId, createdAt])
  @@index([schoolId, studentId])
  @@map("payments")
}

model Refund {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  schoolId          String   @map("school_id")
  paymentId         String   @map("payment_id")
  refundNumber      String   @unique @map("refund_number")
  amount            Decimal  @db.Decimal(12, 2)
  reason            String
  processedByUserId String   @map("processed_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  processor    User         @relation("processor", fields: [processedByUserId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

// ==========================================
// 7. EXAMINATIONS & MARKS
// ==========================================

model GradingScale {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  name       String   // e.g. Standard CBSE Grade Scale
  minMark    Decimal  @db.Decimal(5, 2) @map("min_mark")
  maxMark    Decimal  @db.Decimal(5, 2) @map("max_mark")
  gradePoint Decimal  @db.Decimal(3, 2) @map("grade_point")
  gradeName  String   @map("grade_name") // e.g. A1, A2
  remarks    String?
  createdAt  DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("grading_scales")
}

model Exam {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  academicYearId String   @map("academic_year_id")
  name           String   // e.g. Mid-Term Examination 2026
  code           String
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  isPublished    Boolean  @default(false) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  examSchedules ExamSchedule[]

  @@unique([schoolId, code])
  @@map("exams")
}

model ExamSchedule {
  id        String   @id @default(uuid())
  examId    String   @map("exam_id")
  classId   String   @map("class_id")
  sectionId String   @map("section_id")
  subjectId String   @map("subject_id")
  date      DateTime
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  maxMarks  Decimal  @db.Decimal(5, 2) @map("max_marks")
  passMarks Decimal  @db.Decimal(5, 2) @map("pass_marks")
  createdAt DateTime @default(now()) @map("created_at")

  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentMarks StudentMark[]

  @@unique([examId, classId, sectionId, subjectId])
  @@map("exam_schedules")
}

model StudentMark {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  examScheduleId String   @map("exam_schedule_id")
  studentId      String   @map("student_id")
  marksObtained  Decimal  @db.Decimal(5, 2) @map("marks_obtained")
  grade          String?
  isAbsent       Boolean  @default(false) @map("is_absent")
  remarks        String?
  enteredByUserId String  @map("entered_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredByUser User        @relation(fields: [enteredByUserId], references: [id], onDelete: Cascade)

  @@unique([examScheduleId, studentId])
  @@index([schoolId, studentId])
  @@map("student_marks")
}

model ReportCard {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  academicYearId String   @map("academic_year_id")
  studentId      String   @map("student_id")
  classId        String   @map("class_id")
  totalMarks     Decimal  @db.Decimal(7, 2) @map("total_marks")
  obtainedMarks  Decimal  @db.Decimal(7, 2) @map("obtained_marks")
  percentage     Decimal  @db.Decimal(5, 2)
  grade          String?
  rank           Int?
  remarks        String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, studentId])
  @@map("report_cards")
}

// ==========================================
// 8. OPERATIONS, NOTICES & AUDIT
// ==========================================

enum TargetAudience {
  ALL
  TEACHERS
  STUDENTS
  PARENTS
}

model Notice {
  id              String         @id @default(uuid())
  organizationId  String         @map("organization_id")
  schoolId        String         @map("school_id")
  title           String
  content         String         @db.Text
  targetAudience  TargetAudience @default(ALL) @map("target_audience")
  publishedAt     DateTime       @default(now()) @map("published_at")
  createdByUserId String         @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, targetAudience])
  @@map("notices")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model Notification {
  id              String              @id @default(uuid())
  organizationId  String              @map("organization_id")
  schoolId        String              @map("school_id")
  recipientUserId String              @map("recipient_user_id")
  title           String
  message         String              @db.Text
  channel         NotificationChannel @default(IN_APP)
  isRead          Boolean             @default(false) @map("is_read")
  createdAt       DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, recipientUserId, isRead])
  @@map("notifications")
}

model LibraryBook {
  id              String     @id @default(uuid())
  schoolId        String     @map("school_id")
  title           String
  author          String
  isbn            String?
  publisher       String?
  copiesTotal     Int        @default(1) @map("copies_total")
  copiesAvailable Int        @default(1) @map("copies_available")
  createdAt       DateTime   @default(now()) @map("created_at")

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bookLoans BookLoan[]

  @@index([schoolId, title])
  @@map("library_books")
}

enum LoanStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

model BookLoan {
  id             String     @id @default(uuid())
  schoolId       String     @map("school_id")
  bookId         String     @map("book_id")
  borrowerUserId String     @map("borrower_user_id")
  issueDate      DateTime   @default(now()) @map("issue_date")
  dueDate        DateTime   @map("due_date")
  returnDate     DateTime?  @map("return_date")
  fineAmount     Decimal    @default(0) @db.Decimal(10, 2) @map("fine_amount")
  status         LoanStatus @default(ISSUED)
  createdAt      DateTime   @default(now()) @map("created_at")

  school   School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book     LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  borrower User        @relation(fields: [borrowerUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, borrowerUserId])
  @@map("book_loans")
}

model TransportRoute {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  routeName  String   @map("route_name")
  startPoint String   @map("start_point")
  endPoint   String   @map("end_point")
  fare       Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentTransports StudentTransport[]

  @@map("transport_routes")
}

model Vehicle {
  id                 String   @id @default(uuid())
  schoolId           String   @map("school_id")
  registrationNumber String   @unique @map("registration_number")
  capacity           Int
  driverName         String   @map("driver_name")
  driverPhone        String   @map("driver_phone")
  createdAt          DateTime @default(now()) @map("created_at")

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentTransports StudentTransport[]

  @@map("vehicles")
}

model StudentTransport {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  studentId   String   @map("student_id")
  routeId     String   @map("route_id")
  vehicleId   String   @map("vehicle_id")
  pickupPoint String?  @map("pickup_point")
  createdAt   DateTime @default(now()) @map("created_at")

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([studentId])
  @@map("student_transports")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  actorUserId    String   @map("actor_user_id")
  action         String   // e.g. "STUDENT_UPDATE", "FEE_COLLECT"
  entityName     String   @map("entity_name")
  entityId       String   @map("entity_id")
  oldValues      String?  @db.Text @map("old_values")
  newValues      String?  @db.Text @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([schoolId, actorUserId])
  @@map("audit_logs")
}

model FileAsset {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  schoolId         String   @map("school_id")
  uploadedByUserId String   @map("uploaded_by_user_id")
  originalName     String   @map("original_name")
  mimeType         String   @map("mime_type")
  sizeBytes        BigInt   @map("size_bytes")
  storagePath      String   @map("storage_path")
  isPublic         Boolean  @default(false) @map("is_public")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, isPublic])
  @@map("file_assets")
}

// ==========================================
// 3.3 INVENTORY & PROCUREMENT SYSTEM
// ==========================================

model InventoryCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items        InventoryItem[]

  @@unique([schoolId, name])
  @@map("inventory_categories")
}

model InventoryItem {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  schoolId        String   @map("school_id")
  categoryId      String   @map("category_id")
  name            String
  sku             String   @unique
  unit            String
  quantity        Int      @default(0)
  minReorderLevel Int      @default(10) @map("min_reorder_level")
  unitPrice       Decimal  @db.Decimal(10, 2) @map("unit_price")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category     InventoryCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions StockTransaction[]
  poItems      PurchaseOrderItem[]

  @@index([schoolId, categoryId])
  @@map("inventory_items")
}

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT
}

model StockTransaction {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  schoolId       String               @map("school_id")
  itemId         String               @map("item_id")
  type           StockTransactionType
  quantity       Int
  reference      String?
  remarks        String?
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([schoolId, itemId])
  @@map("stock_transactions")
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  name           String
  contactPerson  String?  @map("contact_person")
  email          String?
  phone          String?
  address        String?
  taxId          String?  @map("tax_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  orders       PurchaseOrder[]

  @@index([schoolId, name])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  schoolId       String              @map("school_id")
  supplierId     String              @map("supplier_id")
  orderNumber    String              @unique @map("order_number")
  status         PurchaseOrderStatus @default(DRAFT)
  totalAmount    Decimal             @db.Decimal(12, 2) @map("total_amount")
  orderDate      DateTime            @default(now()) @map("order_date")
  expectedDate   DateTime?           @map("expected_date")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items        PurchaseOrderItem[]

  @@index([schoolId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String  @map("purchase_order_id")
  itemId          String  @map("item_id")
  quantity        Int
  unitPrice       Decimal @db.Decimal(10, 2) @map("unit_price")
  totalPrice      Decimal @db.Decimal(12, 2) @map("total_price")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

// ==========================================
// 3.4 DOCUMENTS & CERTIFICATES SYSTEM
// ==========================================

enum CertificateType {
  BONAFIDE
  TRANSFER_CERTIFICATE
  CHARACTER
  CUSTOM
}

model CertificateTemplate {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  schoolId       String          @map("school_id")
  name           String
  type           CertificateType @default(CUSTOM)
  headerText     String?         @db.Text @map("header_text")
  bodyTemplate   String          @db.Text @map("body_template")
  footerText     String?         @db.Text @map("footer_text")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  certificates IssuedCertificate[]

  @@index([schoolId, type])
  @@map("certificate_templates")
}

model IssuedCertificate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  schoolId       String   @map("school_id")
  templateId     String   @map("template_id")
  studentId      String   @map("student_id")
  certificateNo String   @unique @map("certificate_no")
  content        String   @db.Text
  issuedDate     DateTime @default(now()) @map("issued_date")
  issuedByUserId String   @map("issued_by_user_id")
  fileUrl        String?  @map("file_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  template     CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
  @@map("issued_certificates")
}


